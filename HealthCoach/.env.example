# Django
DJANGO_SECRET_KEY=ganti-dengan-secret-key-random
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini (jangan pernah commit API key asli)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=45

# Local development: sqlite. Ubah menjadi postgresql saat database tim siap.
DB_ENGINE=sqlite
POSTGRES_DB=healthcoach_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Sumber nutrisi yang aktif saat ini. Integrasi database dapat mengganti ini nanti.
NUTRITION_SOURCE=csv
NUTRITION_DATASET_PATH=data/nutrition_cleaned.csv
# Contoh setelah model PostgreSQL milik tim tersedia:
# NUTRITION_SOURCE=database
# NUTRITION_MODEL=nutrition.Nutrition

# Batas upload
MAX_UPLOAD_IMAGES=5
MAX_IMAGE_SIZE_MB=5
MAX_TOTAL_UPLOAD_MB=20

